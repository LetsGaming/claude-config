{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/save-plan.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/restore-plan.mjs\""
          }
        ]
      }
    ]
  }
}
