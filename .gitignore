# Allowlist: everything is ignored unless listed here.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/install.mjs
!/mcp-servers.json
!/settings.base.json
!/shared/
!/lib/
!/agents/
!/commands/
!/hooks/
!/skills/
!/skills.json
!/plugins.json
!/LICENSE
!/docs/
!/_templates/
!/tools/

/tools/restart-state/
/docs/plans/

# Installed from skills.json by install.mjs
/skills/*
!/skills/autonomous-session
!/skills/browser-hygiene
!/skills/changelog-fragments
!/skills/code-audit
!/skills/code-standards
!/skills/frontend-design-craft
!/skills/human-writing-style
!/skills/image-triage
!/skills/improve-code-comments
!/skills/isolated-dev-sessions
!/skills/plan-first

# Local files: settings.json, CLAUDE.md, .install-state.json, skills.local.json and plugins.local.json are ignored by the allowlist above

# Local-only personal overlays
private/

__pycache__/
