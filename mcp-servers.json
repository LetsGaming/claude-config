{
  "playwright-edge": {
    "type": "stdio",
    "command": "npx",
    "args": ["@playwright/mcp@latest", "--browser", "msedge"]
  },
  "playwright-firefox": {
    "type": "stdio",
    "command": "npx",
    "args": ["@playwright/mcp@latest", "--browser", "firefox"]
  },
  "chrome-devtools-edge": {
    "platforms": ["win32"],
    "type": "stdio",
    "command": "npx",
    "args": [
      "chrome-devtools-mcp@latest",
      "--executablePath",
      "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"
    ]
  },
  "graphify": {
    "type": "http",
    "url": "https://api.graphify.com/mcp"
  }
}
