{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "MCP_TOOL_TIMEOUT": "180000",
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opusplan",
  "skillOverrides": {
    "superpowers:executing-plans": "off",
    "superpowers:receiving-code-review": "off",
    "superpowers:requesting-code-review": "off",
    "superpowers:verification-before-completion": "off",
    "superpowers:writing-skills": "off",
    "remember:doctor": "off",
    "remember:remember": "off",
    "chrome-devtools-mcp:a11y-debugging": "off",
    "chrome-devtools-mcp:chrome-devtools": "off",
    "chrome-devtools-mcp:chrome-devtools-cli": "off",
    "chrome-devtools-mcp:cookie-debugging": "off",
    "chrome-devtools-mcp:debug-optimize-lcp": "off",
    "chrome-devtools-mcp:memory-leak-debugging": "off",
    "postman:ai-readiness": "off",
    "postman:api-discovery": "off",
    "postman:api-documentation": "off",
    "postman:api-engineer": "off",
    "postman:api-mocking": "off",
    "postman:api-monitoring": "off",
    "postman:api-testing": "off",
    "postman:bootstrap": "off",
    "postman:ci-integration": "off",
    "postman:collection-schema-v3": "off",
    "postman:flows": "off",
    "postman:performance-testing": "off",
    "postman:postman-mcp-server": "off",
    "claude-mem:agent-cost-report": "off",
    "claude-mem:babysit": "off",
    "claude-mem:ccs-align": "off",
    "claude-mem:cloud-sync": "off",
    "claude-mem:design-is": "off",
    "claude-mem:do": "off",
    "claude-mem:how-it-works": "off",
    "claude-mem:knowledge-agent": "off",
    "claude-mem:learn-codebase": "off",
    "claude-mem:make-plan": "off",
    "claude-mem:mode-creator": "off",
    "claude-mem:oh-my-issues": "off",
    "claude-mem:pathfinder": "off",
    "claude-mem:screenpipe": "off",
    "claude-mem:smart-explore": "off",
    "claude-mem:standup": "off",
    "claude-mem:timeline-report": "off",
    "claude-mem:version-bump": "off",
    "claude-mem:weekly-digests": "off",
    "claude-mem:what-the": "off",
    "claude-mem:wowerpoint": "off",
    "deep-plan:deep-plan": "off",
    "context-mode:context-mode": "off",
    "context-mode:ctx-insight": "off",
    "context-mode:ctx-purge": "off",
    "context-mode:ctx-search": "off",
    "context-mode:ctx-upgrade": "off",
    "animate": "off",
    "animate-expo": "off",
    "animation-vocabulary": "off",
    "apple-design": "off",
    "ask-sonner": "off",
    "brandkit": "off",
    "design-taste-frontend": "off",
    "design-taste-frontend-v1": "off",
    "find-animation-opportunities": "off",
    "find-skills": "off",
    "frontend-design-craft": "off",
    "full-output-enforcement": "off",
    "gpt-taste": "off",
    "high-end-visual-design": "off",
    "image-to-code": "off",
    "imagegen-frontend-mobile": "off",
    "imagegen-frontend-web": "off",
    "improve-animations": "off",
    "industrial-brutalist-ui": "off",
    "minimalist-ui": "off",
    "redesign-existing-projects": "off",
    "stitch-design-taste": "off",
    "write-swift": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/restore-plan.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/no-em-dash.mjs\""
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/save-plan.mjs\""
          }
        ]
      }
    ]
  },
  "effortLevel": "medium",
  "theme": "dark",
  "autoCompactEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true
}
