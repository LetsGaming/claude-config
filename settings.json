{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "MCP_TOOL_TIMEOUT": "180000",
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opusplan",
  "skillOverrides": {
    "superpowers:executing-plans": "off",
    "superpowers:receiving-code-review": "off",
    "superpowers:requesting-code-review": "off",
    "superpowers:verification-before-completion": "off",
    "superpowers:writing-skills": "off",
    "claude-md-management:revise-claude-md": "off",
    "claude-md-management:claude-md-improver": "off",
    "remember:doctor": "off",
    "remember:remember": "off",
    "skill-creator:skill-creator": "off",
    "chrome-devtools-mcp:a11y-debugging": "off",
    "chrome-devtools-mcp:chrome-devtools": "off",
    "chrome-devtools-mcp:chrome-devtools-cli": "off",
    "chrome-devtools-mcp:cookie-debugging": "off",
    "chrome-devtools-mcp:debug-optimize-lcp": "off",
    "chrome-devtools-mcp:memory-leak-debugging": "off",
    "playground:playground": "off",
    "postman:ai-readiness": "off",
    "postman:api-discovery": "off",
    "postman:api-documentation": "off",
    "postman:api-engineer": "off",
    "postman:api-mocking": "off",
    "postman:api-monitoring": "off",
    "postman:api-testing": "off",
    "postman:bootstrap": "off",
    "postman:ci-integration": "off",
    "postman:collection-schema-v3": "off",
    "postman:flows": "off",
    "postman:performance-testing": "off",
    "postman:postman-mcp-server": "off",
    "ui-theme-designer:ui-theme-designer-design-tokens": "off",
    "ui-theme-designer:ui-theme-designer-help": "off",
    "superdesign:superdesign": "off",
    "claude-mem:agent-cost-report": "off",
    "claude-mem:babysit": "off",
    "claude-mem:ccs-align": "off",
    "claude-mem:cloud-sync": "off",
    "claude-mem:design-is": "off",
    "claude-mem:do": "off",
    "claude-mem:how-it-works": "off",
    "claude-mem:knowledge-agent": "off",
    "claude-mem:learn-codebase": "off",
    "claude-mem:make-plan": "off",
    "claude-mem:mode-creator": "off",
    "claude-mem:oh-my-issues": "off",
    "claude-mem:pathfinder": "off",
    "claude-mem:screenpipe": "off",
    "claude-mem:smart-explore": "off",
    "claude-mem:standup": "off",
    "claude-mem:timeline-report": "off",
    "claude-mem:version-bump": "off",
    "claude-mem:weekly-digests": "off",
    "claude-mem:what-the": "off",
    "claude-mem:wowerpoint": "off",
    "deep-plan:deep-plan": "off",
    "ponytail:ponytail-audit": "off",
    "ponytail:ponytail-debt": "off",
    "ponytail:ponytail-gain": "off",
    "ponytail:ponytail-help": "off",
    "ponytail:ponytail-review": "off",
    "context-mode:context-mode": "off",
    "context-mode:ctx-insight": "off",
    "context-mode:ctx-purge": "off",
    "context-mode:ctx-search": "off",
    "context-mode:ctx-upgrade": "off",
    "animate": "off",
    "animate-expo": "off",
    "animation-vocabulary": "off",
    "apple-design": "off",
    "ask-sonner": "off",
    "brandkit": "off",
    "design-taste-frontend": "off",
    "design-taste-frontend-v1": "off",
    "find-animation-opportunities": "off",
    "find-skills": "off",
    "frontend-design-craft": "off",
    "full-output-enforcement": "off",
    "gpt-taste": "off",
    "high-end-visual-design": "off",
    "image-to-code": "off",
    "imagegen-frontend-mobile": "off",
    "imagegen-frontend-web": "off",
    "improve-animations": "off",
    "industrial-brutalist-ui": "off",
    "minimalist-ui": "off",
    "redesign-existing-projects": "off",
    "stitch-design-taste": "off",
    "write-swift": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"C:/Users/USER/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/restore-plan.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/no-em-dash.mjs\""
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/save-plan.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "playground@claude-plugins-official": false,
    "remember@claude-plugins-official": true,
    "gitlab@claude-plugins-official": false,
    "postman@claude-plugins-official": true,
    "data-engineering@claude-plugins-official": false,
    "claude-security@claude-plugins-official": true,
    "browser-use@claude-plugins-official": false,
    "ui-theme-designer@claude-plugins-official": false,
    "superdesign@claude-plugins-official": false,
    "impeccable@impeccable": true,
    "claude-mem@thedotmack": true,
    "deep-plan@piercelamb-plugins": true,
    "context-mode@context-mode": true,
    "ruflo-adr@ruflo": false,
    "ruflo-agent@ruflo": false,
    "ruflo-core@ruflo": false,
    "ruflo-autopilot@ruflo": false,
    "ruflo-browser@ruflo": false,
    "ruflo-cost-tracker@ruflo": false
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "piercelamb-plugins": {
      "source": {
        "source": "github",
        "repo": "piercelamb/deep-plan"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "ruflo": {
      "source": {
        "source": "github",
        "repo": "ruvnet/ruflo"
      }
    }
  },
  "effortLevel": "medium",
  "theme": "dark",
  "autoCompactEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true
}
